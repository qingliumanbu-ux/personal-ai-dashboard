# Absolute path to an Obsidian-style Vault.
# When omitted, the app uses ../个人知识库.
PERSONAL_DASHBOARD_VAULT_ROOT=/absolute/path/to/your-vault

# Select the matching directory layout. The default uses 10_raw/ and wiki/.
PERSONAL_DASHBOARD_VAULT_LAYOUT=dashboard-v1

# Set true when the Dashboard must never change files inside the connected Vault.
PERSONAL_DASHBOARD_READ_ONLY=true

# Dashboard proxies this loopback service so the browser stays same-origin.
PERSONAL_DASHBOARD_INGESTION_URL=http://127.0.0.1:8765

# Python executable used to run the internal ingestion service.
PERSONAL_DASHBOARD_INGESTION_PYTHON=/absolute/path/to/ingestion-venv/python

# Rebuildable queue state and approved source directories.
PERSONAL_DASHBOARD_INGESTION_RUNTIME_ROOT=/absolute/path/to/ingestion-runtime
# Optional. Point this at an existing compatible queue database during migration.
# PERSONAL_DASHBOARD_INGESTION_DATABASE_PATH=/absolute/path/to/workbench.db
PERSONAL_DASHBOARD_INGESTION_ALLOWED_ROOTS=/absolute/path/to/video-library

# Existing local transcription provider. Media is processed locally.
PERSONAL_DASHBOARD_TRANSCRIPTION_PYTHON=/absolute/path/to/transcription-venv/python
PERSONAL_DASHBOARD_TRANSCRIPTION_SCRIPT=/absolute/path/to/transcribe_video.py
PERSONAL_DASHBOARD_TRANSCRIPTION_MODEL_DIR=/absolute/path/to/faster-whisper-model

# Optional. Keep the development server loopback-only unless you add auth.
# PERSONAL_DASHBOARD_HOST=127.0.0.1
